# Example only: generate a unique secret locally and keep it private.
SECRET_KEY=REPLACE_WITH_A_NEW_RANDOM_LOCAL_SECRET

# Set an absolute path to a fresh database inside this workspace .test-data directory.
COLLABORATION_DATABASE=/absolute/path/to/Main-Collaboration/.test-data/example.sqlite

# Optional workflow email delivery. Leave SMTP_HOST empty to disable email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@example.com
SMTP_FROM_NAME=G-Sub
SMTP_USE_TLS=true
SMTP_USE_SSL=false
